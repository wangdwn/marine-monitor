  "glossary": [
    {
      "id": 1,
      "termZh": "蓝色经济",
      "termEn": "Blue Economy",
      "category": "econ",
      "definition": "以海洋资源为依托、以海洋产业为支撑的可持续发展经济模式，强调海洋生态保护与经济增长协同。",
      "source": "世界银行"
    },
    {
      "id": 2,
      "termZh": "海洋生产总值",
      "termEn": "Gross Ocean Product",
      "category": "econ",
      "definition": "一定时期内海洋经济活动创造的增加值总和，是衡量海洋经济发展规模的核心指标。",
      "source": "国家统计局"
    },
    {
      "id": 3,
      "termZh": "海洋功能区划",
      "termEn": "Marine Functional Zoning",
      "category": "policy",
      "definition": "依据海洋自然属性和社会需求，将海域划分为不同功能区，实行分区分类管理的制度。",
      "source": "自然资源部"
    },
    {
      "id": 4,
      "termZh": "海上风电",
      "termEn": "Offshore Wind Power",
      "category": "industry",
      "definition": "利用海上风能发电的清洁能源产业，是海洋新能源的主力方向。",
      "source": "通用"
    },
    {
      "id": 5,
      "termZh": "远洋渔业",
      "termEn": "Distant-water Fishery",
      "category": "industry",
      "definition": "在本国管辖海域之外从事的捕捞及配套加工、补给等渔业生产活动。",
      "source": "农业农村部"
    },
    {
      "id": 6,
      "termZh": "海洋碳汇",
      "termEn": "Blue Carbon",
      "category": "industry",
      "definition": "红树林、盐沼、海草床等滨海蓝碳生态系统吸收并储存大气二氧化碳的过程与能力。",
      "source": "通用"
    },
    {
      "id": 7,
      "termZh": "港口吞吐量",
      "termEn": "Port Throughput",
      "category": "port",
      "definition": "一定时期内经由港口装卸的货物数量，通常以万吨或万TEU计。",
      "source": "交通运输部"
    },
    {
      "id": 8,
      "termZh": "海水淡化",
      "termEn": "Seawater Desalination",
      "category": "industry",
      "definition": "去除海水中盐分生产淡水的技术与产业，是沿海地区水资源补充来源。",
      "source": "通用"
    }
  ],
